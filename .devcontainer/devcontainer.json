{
  "name": "lanternbook",
  // Node 24 is the active LTS line; the exact version is pinned in .nvmrc and package.json engines.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:3-24-bookworm",
  "remoteUser": "node",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },
  "mounts": [
    // Named volume so Claude's login and history survive container rebuilds.
    "source=claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    // Host CA certificates, for networks behind a TLS-inspecting proxy (docs/DEV-CONTAINER.md).
    // The parent is mounted because it exists on any Linux or WSL host, so a host without a
    // ca-certificates directory still starts. Read-only, and never over the container's own CAs.
    "source=/usr/local/share,target=/mnt/host-usr-local-share,type=bind,readonly"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    // Corepack, pnpm and npm ignore the system store unless Node is pointed at it.
    "NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/ca-certificates.crt"
  },
  // Host CAs first, so every later download trusts them. A fresh named volume is created
  // root-owned; both steps are safe to repeat.
  "onCreateCommand": "sudo bash .devcontainer/install-host-ca.sh /mnt/host-usr-local-share/ca-certificates && sudo chown -R node:node /home/node/.claude",
  // pnpm is pinned by the packageManager field in package.json and provided through corepack.
  "postCreateCommand": "sudo corepack enable && bash scripts/setup.sh && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["Vue.volar", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
