#!/usr/bin/env sh
set -eu

gitleaks_bin=$(command -v gitleaks || true)
if [ -z "$gitleaks_bin" ] && [ -x "$HOME/.local/bin/gitleaks" ]; then
  gitleaks_bin="$HOME/.local/bin/gitleaks"
fi
if [ -z "$gitleaks_bin" ]; then
  echo "pre-commit: gitleaks is not installed, so staged files cannot be scanned. Run scripts/setup.sh" >&2
  exit 1
fi

echo "pre-commit: gitleaks on staged files"
"$gitleaks_bin" git --pre-commit --staged --redact --no-banner --no-color --verbose

echo "pre-commit: lint-staged"
pnpm exec lint-staged

echo "pre-commit: typecheck"
pnpm typecheck

echo "pre-commit: related tests"
node scripts/hooks/related-tests.mjs
